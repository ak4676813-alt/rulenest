# RuleNest is currently a frontend-only prototype.
# There are NO required environment variables — the app runs entirely on
# local mock data persisted to localStorage.
#
# When you connect a real backend, copy this file to ".env" and set:
#
# VITE_API_URL=https://api.your-domain.com
# VITE_AUTH_MODE=api        # "local" (prototype) | "api" (real backend)f